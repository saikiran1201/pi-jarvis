# PI-Jarvis agent image for OpenShell sandboxes
FROM docker.io/library/node:22-bookworm-slim
RUN npm install -g @earendil-works/pi-coding-agent@1.5.2

# jarvis brain seed: copied into the agent config dir by the entrypoint
COPY AGENTS.md /opt/jarvis-seed/AGENTS.md
COPY skills/ /opt/jarvis-seed/skills/
COPY sandbox/entrypoint.sh /usr/local/bin/jarvis-init
RUN chmod +x /usr/local/bin/jarvis-init

# non-root: the node image already ships uid 1000 with /home/node
USER 1000
ENV PI_CODING_AGENT_DIR=/home/node/.pi-jarvis
ENTRYPOINT ["/usr/local/bin/jarvis-init"]
